<Window x:Class="VoicePilot.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:VoicePilot.App.Controls"
        xmlns:viewmodels="clr-namespace:VoicePilot.App.ViewModels"
        d:DataContext="{d:DesignInstance Type=viewmodels:MainViewModel}"
        mc:Ignorable="d"
        Title="VoicePilot AI - Native Desktop Voice Assistant"
        Height="780" Width="480"
        MinHeight="600" MinWidth="420"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDarkBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Top App Bar -->
            <RowDefinition Height="Auto" />
            <!-- Conversation History Feed -->
            <RowDefinition Height="*" />
            <!-- Sensitive Action Confirmation Banner -->
            <RowDefinition Height="Auto" />
            <!-- Live Transcription & Waveform -->
            <RowDefinition Height="Auto" />
            <!-- Voice Controls & Text Bar -->
            <RowDefinition Height="Auto" />
            <!-- Status Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Top App Bar -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="VoicePilot AI" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <Border Background="#1F2937" CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                            <TextBlock Text="v1.0" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AccentCyanColor}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding PrivacyStatusText}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="🗑 Clear" Style="{StaticResource FluentButtonStyle}" Padding="8,4" FontSize="11" Margin="0,0,8,0"
                            ToolTip="Clear conversation history" Command="{Binding ClearHistoryCommand}" />
                    <Button Content="⚙ Settings" Style="{StaticResource FluentButtonStyle}" Padding="10,4" FontSize="11"
                            ToolTip="Configure local speech, AI models, and permissions" Command="{Binding OpenSettingsCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Conversation Feed -->
        <ScrollViewer Grid.Row="1" x:Name="ChatScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16,12">
            <ItemsControl ItemsSource="{Binding Conversation}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type viewmodels:ConversationBubbleViewModel}">
                        <StackPanel Margin="0,8">
                            <!-- User Utterance (Right aligned) -->
                            <Grid HorizontalAlignment="Right" MaxWidth="360" Margin="40,0,0,6">
                                <Border Background="#252A3D" BorderBrush="#353D58" BorderThickness="1" CornerRadius="12,12,2,12" Padding="12,8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding UserUtterance}" FontSize="13" Foreground="#FFFFFF" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding TimeFormatted}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Assistant Response (Left aligned) -->
                            <Grid HorizontalAlignment="Left" MaxWidth="380" Margin="0,0,40,6">
                                <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12,12,12,2" Padding="12,10">
                                    <StackPanel>
                                        <!-- Engine & Action Tag -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <Border Background="#1E293B" CornerRadius="4" Padding="5,2" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding Engine}" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource AccentCyanColor}" />
                                            </Border>
                                            <Border Background="#312E81" CornerRadius="4" Padding="5,2" Visibility="{Binding HasAction, Converter={StaticResource BoolToVisConverter}}">
                                                <TextBlock Text="{Binding ActionName}" FontSize="9" FontWeight="SemiBold" Foreground="#A5B4FC" />
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Text="{Binding AssistantResponse}" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding TimeFormatted}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 3. Sensitive Action Confirmation Banner -->
        <Border Grid.Row="2" Background="#2A1B14" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1" CornerRadius="8" Margin="16,4" Padding="14,10"
                Visibility="{Binding HasPendingConfirmation, Converter={StaticResource BoolToVisConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0">
                    <TextBlock Text="⚠ Action Confirmation Required" FontWeight="Bold" FontSize="13" Foreground="{StaticResource WarningBrush}" />
                    <TextBlock Margin="0,4,0,0" Text="{Binding ConfirmationPrompt}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button Content="✕ Deny" Style="{StaticResource FluentButtonStyle}" Command="{Binding CancelActionCommand}" Padding="12,6" Margin="0,0,10,0" />
                    <Button Content="✓ Confirm &amp; Execute" Style="{StaticResource AccentButtonStyle}" Command="{Binding ConfirmActionCommand}" Padding="14,6" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 4. Live Speech Transcription & Waveform Visualizer -->
        <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="16,8">
            <StackPanel>
                <!-- Live Transcription Display -->
                <TextBlock Text="{Binding LiveTranscription}" FontSize="13" FontStyle="Italic" TextWrapping="Wrap"
                           Foreground="{StaticResource AccentCyanColor}" MinHeight="18" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,4" />

                <!-- Dynamic Real-Time Waveform Visualizer -->
                <controls:WaveformVisualizer Height="42"
                                            AudioLevel="{Binding AudioLevel}"
                                            IsListening="{Binding IsListening}"
                                            Margin="8,2" />
            </StackPanel>
        </Border>

        <!-- 5. Voice Controls & Push-to-Talk -->
        <Border Grid.Row="4" Background="{StaticResource SurfaceBrush}" Padding="16,8,16,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Center Mic Push-to-Talk Button -->
                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,12">
                    <Button Style="{StaticResource MicButtonStyle}" Command="{Binding ToggleListeningCommand}" ToolTip="Click or press hotkey to toggle voice listening">
                        <Grid>
                            <!-- Microphone Icon Path -->
                            <Path Width="24" Height="24" Stretch="Uniform" Fill="#FFFFFF"
                                  Data="M12,2A3,3 0 0,0 9,5V11A3,3 0 0,0 12,14A3,3 0 0,0 15,11V5A3,3 0 0,0 12,2M19,11C19,14.53 16.39,17.44 13,17.93V21H11V17.93C7.61,17.44 5,14.53 5,11H7A5,5 0 0,0 12,16A5,5 0 0,0 17,11H19Z" />
                        </Grid>
                    </Button>
                    <TextBlock Text="{Binding StateBadgeText}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>

                <!-- Text Command Fallback Bar -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Style="{StaticResource FluentTextBoxStyle}"
                             Text="{Binding TextInput, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="OnTextInputKeyDown" />
                    <Button Grid.Column="1" Content="Send" Style="{StaticResource AccentButtonStyle}"
                            Command="{Binding SendTextCommand}" Margin="8,0,0,0" Width="70" />
                </Grid>
            </Grid>
        </Border>

        <!-- 6. Status Bar -->
        <Border Grid.Row="5" Background="#0A0C10" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State}" Value="Listening">
                                    <Setter Property="Fill" Value="{StaticResource AccentCyanColor}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="Processing">
                                    <Setter Property="Fill" Value="{StaticResource AccentVioletColor}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="Error">
                                    <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>

                <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>

    </Grid>
</Window>
