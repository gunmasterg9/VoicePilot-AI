<Window x:Class="VoicePilot.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:VoicePilot.App.ViewModels"
        d:DataContext="{d:DesignInstance Type=viewmodels:SettingsViewModel}"
        mc:Ignorable="d"
        Title="VoicePilot Settings"
        Height="680" Width="640"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgDarkBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        ResizeMode="NoResize">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="⚙ Settings &amp; Preferences" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Text="Configure local speech recognition, text-to-speech, Ollama AI, and security allowlists."
                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Main Settings Scroll Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
            <StackPanel>

                <!-- Speech Recognition Section -->
                <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="🎙 Speech Recognition Engine" FontWeight="Bold" FontSize="14" Foreground="{StaticResource AccentCyanColor}" Margin="0,0,0,10" />
                        
                        <RadioButton Content="Windows SAPI (Instant, zero download)" IsChecked="True"
                                     Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10" />

                        <StackPanel Margin="0,6,0,0">
                            <TextBlock Text="{Binding WhisperStatus}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                            <ProgressBar Height="6" Maximum="1" Value="{Binding WhisperDownloadProgress}" Margin="0,0,0,6" Foreground="{StaticResource AccentCyanColor}" />
                            <Button Content="📥 Download Whisper Model (ggml-tiny.bin ~75MB)"
                                    Style="{StaticResource FluentButtonStyle}"
                                    Command="{Binding DownloadWhisperModelCommand}" HorizontalAlignment="Left" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Speech Synthesis Section -->
                <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="🔊 Speech Synthesis (TTS)" FontWeight="Bold" FontSize="14" Foreground="{StaticResource AccentVioletColor}" Margin="0,0,0,10" />

                        <CheckBox Content="Enable spoken voice output" IsChecked="{Binding TtsEnabled}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10" />

                        <TextBlock Text="Voice Selection:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding AvailableVoices}" DisplayMemberPath="Name" SelectedValuePath="Name"
                                  SelectedValue="{Binding SelectedVoice}" Height="32" Margin="0,0,0,10" />

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="36" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Speech Rate: " VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                            <Slider Grid.Column="1" Minimum="-10" Maximum="10" Value="{Binding TtsRate}" Margin="10,0" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding TtsRate}" VerticalAlignment="Center" FontSize="12" HorizontalAlignment="Right" />
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="36" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Volume: " VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                            <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding TtsVolume}" Margin="10,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding TtsVolume}" VerticalAlignment="Center" FontSize="12" HorizontalAlignment="Right" />
                        </Grid>

                        <Button Content="🔊 Test Voice Output" Style="{StaticResource FluentButtonStyle}" Command="{Binding TestSpeechCommand}" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>

                <!-- Local Ollama LLM Section -->
                <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="🤖 Local AI Inference (Ollama)" FontWeight="Bold" FontSize="14" Foreground="{StaticResource AccentCyanColor}" Margin="0,0,0,4" />
                        <TextBlock Text="When enabled, natural language is interpreted by your local Ollama instance." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10" />

                        <CheckBox Content="Enable Ollama LLM intent parsing (falls back to rule-based offline)" IsChecked="{Binding OllamaEnabled}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10" />

                        <TextBlock Text="Endpoint URL:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource FluentTextBoxStyle}" Text="{Binding OllamaEndpoint, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                        <TextBlock Text="Model Name (e.g. llama3.2, mistral, phi3):" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource FluentTextBoxStyle}" Text="{Binding OllamaModel, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button Content="🔌 Test Ollama Connection" Style="{StaticResource FluentButtonStyle}" Command="{Binding TestOllamaCommand}" Margin="0,0,10,0" />
                            <TextBlock Text="{Binding OllamaStatus}" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Hotkeys & Background Operation -->
                <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="⌨ System Integration &amp; Hotkeys" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10" />

                        <TextBlock Text="Global Summon Hotkey:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource FluentTextBoxStyle}" Text="{Binding GlobalHotkey, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                        <CheckBox Content="Minimize to system tray when closing window" IsChecked="{Binding MinimizeToTray}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />
                        <CheckBox Content="Save conversation history locally" IsChecked="{Binding SaveHistory}" Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Authorized Directories Allowlist -->
                <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="🛡 Security &amp; Directory Allowlists" FontWeight="Bold" FontSize="14" Foreground="{StaticResource SuccessBrush}" Margin="0,0,0,4" />
                        <TextBlock Text="VoicePilot actions may only access authorized folders (Standard user folders are allowed by default)." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10" />

                        <ListBox ItemsSource="{Binding AllowedDirectories}" MaxHeight="90" Background="#12151D" BorderBrush="{StaticResource CardBorderBrush}" Margin="0,0,0,10">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding}" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <Button Grid.Column="1" Content="✕" Margin="6,0,0,0" Padding="6,2"
                                                Command="{Binding DataContext.RemoveFolderCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}" Style="{StaticResource FluentButtonStyle}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="📁 Add Safe Folder..." Style="{StaticResource FluentButtonStyle}" Command="{Binding AddFolderCommand}" Margin="0,0,10,0" />
                            <Button Content="📂 Open Local Data Folder" Style="{StaticResource FluentButtonStyle}" Command="{Binding OpenAppDataFolderCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer Actions -->
        <Border Grid.Row="2" Margin="0,16,0,0" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource FluentButtonStyle}" Click="OnCancelClick" Width="90" Margin="0,0,10,0" />
                <Button Content="Save &amp; Apply" Style="{StaticResource AccentButtonStyle}" Command="{Binding SaveSettingsCommand}" Width="120" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
