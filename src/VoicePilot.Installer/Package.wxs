<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="VoicePilot AI"
           Manufacturer="VoicePilot AI Team"
           Version="1.0.0"
           UpgradeCode="6D764A92-9C1C-4B79-880F-226815FA7A61"
           Scope="perUserOrMachine">
    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="VoicePilot AI" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcutComponent" Guid="A73D54A8-1E74-4C27-9154-150E6088BC14">
        <Shortcut Id="ApplicationDesktopShortcut"
                  Name="VoicePilot AI"
                  Description="VoicePilot AI Native Desktop Voice Assistant"
                  Target="[INSTALLFOLDER]VoicePilot.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\VoicePilotAI" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcutComponent" Guid="5F82142B-788B-4965-9DE8-574DF5C48A25">
        <Shortcut Id="ApplicationStartMenuShortcut"
                  Name="VoicePilot AI"
                  Description="VoicePilot AI Native Desktop Voice Assistant"
                  Target="[INSTALLFOLDER]VoicePilot.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\VoicePilotAI" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="MainFeature" Title="VoicePilot AI Application" Level="1">
      <Files Include="$(var.PublishDir)\**" Directory="INSTALLFOLDER" />
      <ComponentRef Id="DesktopShortcutComponent" />
      <ComponentRef Id="StartMenuShortcutComponent" />
    </Feature>
  </Package>
</Wix>
